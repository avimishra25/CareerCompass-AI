MONGO_URI=mongodb://127.0.0.1:27017/careercompass
JWT_SECRET=
PORT=5000
# Google OAuth (register the callback URL in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Where the OAuth callback redirects with ?token=...
CLIENT_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000
# JD matching uses ML_SERVICE_URL and the shared INTERNAL_API_KEY; no LLM key is needed.
INTERNAL_API_KEY=
# 0 locally; 1 only behind one trusted reverse proxy (Render).
TRUST_PROXY_HOPS=0
EMAIL_USER=
EMAIL_PASS=
